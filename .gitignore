# Secretos: tokio-backend/.gitignore ya cubre su propio .env, pero un archivo
# de entorno creado en la raíz del repo quedaba sin ignorar y podía commitearse.
.env
.env.*
!.env.example

# Entornos virtuales y caché de Python
venv/
.venv/
__pycache__/
*.py[cod]

# Sistema operativo / editores
Thumbs.db
.DS_Store

# Claude Code: se versionan los agentes del proyecto (.claude/agents/), pero no
# los archivos de runtime ni la configuración local de cada máquina.
.claude/scheduled_tasks.lock
.claude/settings.local.json
